{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "ssh-man",
  "outputfilename": "ssh-man",
  "frontend:install": "node ../scripts/pnpm.cjs install --frozen-lockfile",
  "frontend:build": "node ../scripts/pnpm.cjs run build",
  "frontend:dev:watcher": "node ../scripts/pnpm.cjs run dev",
  "frontend:dir": "frontend",
  "author": {
    "name": "Eric Wooley"
  },
  "info": {
    "companyName": "Eric Wooley",
    "productName": "SSH Man",
    "productVersion": "1.0.0",
    "copyright": "Copyright Eric Wooley",
    "comments": "SSH connection manager",
    "protocols": [
      {
        "scheme": "http",
        "description": "HTTP web links",
        "role": "Viewer"
      },
      {
        "scheme": "https",
        "description": "HTTPS web links",
        "role": "Viewer"
      }
    ]
  }
}
